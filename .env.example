# Existing Turso database URL. Confirm the exact URL in your Turso console.
TURSO_DATABASE_URL=https://your-database-your-region.turso.io

# Generate a NEW read/write Turso auth token after revoking any previously exposed token.
# Automatic config sync needs write permission. Keep this only in Vercel Environment Variables;
# never put it in index.html, browser storage, chat, or a public repository.
TURSO_AUTH_TOKEN=replace-with-a-new-turso-auth-token
RUNNER_INGEST_TOKEN=replace-with-a-long-random-runner-ingest-secret
